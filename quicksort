#include <stdio.h>
void printArray(int arr[], int n) {
    for (int i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");
}
void quick(int arr[], int low, int high, int n) {
    if (low < high) {
        int pivot = arr[high];
        int i = (low - 1);

        for (int j = low; j < high; j++) {
            if (arr[j] < pivot) {
                i++;
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }

        int temp = arr[i + 1];
        arr[i + 1] = arr[high];
        arr[high] = temp;

        printf("Trạng thái mảng (quickSort): ");
        printArray(arr, n);

        int pi = i + 1; //pi la pivot

        quick(arr, low, pi - 1, n);
        quick(arr, pi + 1, high, n);
    }
}

int main() {
    int arr[100], n;
    printf("Nhập số phần tử của mảng: ");
    scanf("%d", &n);
    printf("Nhập %d phần tử: ", n);
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    printf("\n--- SẮP XẾP NHANH (QUICK SORT) ---\n");
    quickSort(arr, 0, n - 1, n);
    printf("Kết quả cuối cùng: ");
    printArray(arr, n);
    printf("\nĐỘ PHỨC TẠP THUẬT TOÁN\n");
    printf("Trung bình: O(n log n)\n");
    printf("Tốt nhất:   O(n log n)\n");
    printf("Xấu nhất:   O(n^2)\n");

    return 0;
}
